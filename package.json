{
  "name": "headsup",
  "version": "0.1.0",
  "description": "A desktop reminder app that flies your reminders across the screen.",
  "author": "Marian Gasinu",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "gen:icons": "node scripts/generate-tray-icon.cjs && node scripts/generate-app-icon.cjs",
    "dev": "npm run gen:icons && electron-vite dev",
    "build": "npm run gen:icons && electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
